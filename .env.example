# ==== Summarizer Konfiguration (kopieren nach .env) ====

# --- App ---
# Einziger nach aussen sichtbarer Port (Studio-Weboberflaeche)
APP_PORT=8181
# Fertiges Image von Docker Hub; leer lassen = Standard (mtprause/summarizer:latest)
# APP_IMAGE=mtprause/summarizer:latest
# always = bei jedem Start nach Updates suchen
APP_PULL_POLICY=missing

# --- Datenbank ---
POSTGRES_DB=summarizer
POSTGRES_USER=summarizer
POSTGRES_PASSWORD=summarizer

# --- Auth ---
# Login: Benutzername/E-Mail + Passwort. Admin-Passwort leer = wird generiert und geloggt.
ADMIN_PASSWORD=

# --- LLM ---
# Bei Compose-Profil local-llm: http://ollama:11434
# Bei Ollama auf dem Host (Windows/Mac App): http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434
# Host-Port des Ollama-Containers (aendern, falls lokal schon ein Ollama auf 11434 laeuft)
OLLAMA_PORT=11434
# Wird beim ersten Start automatisch heruntergeladen (ollama-init)
CHAT_MODEL=qwen3.5:4b
# Sprache der Inhalte (einmalig!): Englisch -> nomic-embed-text (768), Deutsch/multilingual -> bge-m3 (1024)
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# --- Audio-Transkription (Compose-Profil "whisper") ---
# Whisper-Modell: tiny/base/small/medium (groesser = besser + langsamer, CPU: small empfohlen)
WHISPER_MODEL=small


# Zugriff von unterwegs: Telegram-Bot (Token im Studio unter System eintragen).
