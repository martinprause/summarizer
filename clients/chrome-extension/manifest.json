{
    "manifest_version": 3,
    "name": "Summarizer",
    "version": "0.1.0",
    "description": "Webseiten, Auswahl und Bilder an dein Summarizer Studio senden",
    "permissions": ["storage", "contextMenus", "activeTab", "scripting", "notifications"],
    "host_permissions": ["<all_urls>"],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "An Summarizer senden"
    },
    "options_page": "options.html",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}
